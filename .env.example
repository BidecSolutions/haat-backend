# Copy this file to .env and configure

APP_NAME=HAAT
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=haat
DB_USERNAME=root
DB_PASSWORD=

# Cache & Session
CACHE_STORE=file
SESSION_DRIVER=file

# Mail - REQUIRED for OTP to reach inbox (see MAIL_SETUP.md)
# log = emails go to storage/logs/laravel.log (no inbox)
# smtp = real delivery (Gmail, Mailtrap, etc.)
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@haat.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail example (use App Password, not normal password):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
# MAIL_ENCRYPTION=tls
